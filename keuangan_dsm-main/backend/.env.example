# Salin file ini menjadi .env lalu isi nilainya. Jangan pernah commit file .env.

# Koneksi PostgreSQL
DATABASE_URL="postgresql://postgres:ISI_PASSWORD@localhost:5432/keuangan_dsm?schema=public"

# Kunci penanda token login. WAJIB acak dan minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# ---- Opsional (nilai di bawah adalah bawaan) ----
# PORT=3000
# NODE_ENV=development
# JWT_EXPIRES_IN=8h
# Alamat frontend bila diakses langsung tanpa proxy Vite (pisahkan koma bila lebih dari satu)
# CORS_ORIGIN=http://localhost:5173
# Isi 1 bila di belakang Nginx/Caddy agar pembatas login membaca IP asli
# TRUST_PROXY=0
# LOGIN_MAX_PERCOBAAN=10
# LOGIN_JENDELA_MENIT=15
