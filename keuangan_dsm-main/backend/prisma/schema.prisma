// Skema database Keuangan DSM.
// Dibuat mengikuti bentuk data di frontend: Project -> banyak Pekerjaan (kontrak),
// dan Transaksi (rekening giro / kas) yang bisa terhubung ke pekerjaan + tahap pencairan SP2D.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ENUM
// =====================================================
enum JenisRekening {
  GIRO
  KAS
}

enum ArahDana {
  MASUK
  KELUAR
}

enum KlasifikasiTransaksi {
  PROJECT
  OPERASIONAL
}

enum TahapPencairan {
  UANG_MUKA
  TERMIN_1
  TERMIN_2
  TERMIN_3
  RETENSI
}

// =====================================================
// PROJECT
// Pengelompokan beberapa pekerjaan (kontrak) dalam satu nama project.
// =====================================================
model Project {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pekerjaan Pekerjaan[]
  transaksi Transaksi[]

  @@map("project")
}

// =====================================================
// PEKERJAAN
// 1 baris = 1 kontrak. SP2D tidak disimpan, selalu dihitung dari
// nilai kontrak dan persen potongan PPh (lihat src/lib/sp2d.ts).
// =====================================================
model Pekerjaan {
  id             Int       @id @default(autoincrement())
  projectId      Int       @map("project_id")
  nama           String
  kontrakInaproc String    @unique @map("kontrak_inaproc")
  nomorKontrak   String    @default("") @map("nomor_kontrak")
  tglKontrak     DateTime? @map("tgl_kontrak") @db.Date
  nilaiKontrak   Decimal   @default(0) @map("nilai_kontrak") @db.Decimal(18, 2)
  persenPotongan Decimal   @default(1.75) @map("persen_potongan") @db.Decimal(5, 2)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transaksi Transaksi[]

  @@index([projectId])
  @@map("pekerjaan")
}

// =====================================================
// TRANSAKSI
// Satu tabel untuk rekening giro dan kas.
// Klasifikasi PROJECT memakai projectId + pekerjaanId (+ tahap bila dana masuk
// berupa pencairan SP2D). Klasifikasi OPERASIONAL memakai kategori + subkategori.
// =====================================================
model Transaksi {
  id          Int                  @id @default(autoincrement())
  tanggal     DateTime             @db.Date
  rekening    JenisRekening
  keterangan  String
  arah        ArahDana
  nominal     Decimal              @db.Decimal(18, 2)
  klasifikasi KlasifikasiTransaksi
  projectId   Int?                 @map("project_id")
  pekerjaanId Int?                 @map("pekerjaan_id")
  tahap       TahapPencairan?
  kategori    String?
  subkategori String?
  noInvoice   String               @default("") @map("no_invoice")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  pekerjaan Pekerjaan? @relation(fields: [pekerjaanId], references: [id], onDelete: Restrict)

  @@index([tanggal])
  @@index([projectId])
  @@index([pekerjaanId, tahap])
  @@index([klasifikasi, arah])
  @@map("transaksi")
}

// =====================================================
// USER (login)
// =====================================================
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String // hash bcrypt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
